# Pick ONE LLM provider. All of these have free tiers (as of 2026).

# Ollama - local, unlimited, no API key at all (https://ollama.com/download)
# then run: ollama pull llama3.2

# Groq - free tier: 30 req/min, 1000 req/day, 200k tokens/day
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini - free Flash models (per-project caps shown in AI Studio)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter - free models, ~50 req/day on the free tier
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Hugging Face token (optional, speeds up embedding downloads)
HF_TOKEN=your_huggingface_token_here
